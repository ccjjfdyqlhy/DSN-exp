# 高考在线抓取技能私有配置（harness 启动时自动加载进 os.environ）
# 注意：现场已存在的同名环境变量优先于这里的值。

# 两次请求之间的最小间隔（秒）—— 对第三方站点保持礼貌，别调太小
GAOKZX_DELAY=0.8

# 单次请求超时（秒）
GAOKZX_TIMEOUT=20

# 请求 UA（站点对移动 UA / 无 UA 的响应不一样，默认用桌面 Chrome）
GAOKZX_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
