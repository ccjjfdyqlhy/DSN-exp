# DSN-exp 全局环境配置
#
# 使用方式:
#   1. 复制为 .env
#   2. 先填写“必需配置”
#   3. 其余项目保持注释即可使用 config.py 中的默认值
#
# 布尔值统一使用 true / false。时间单位在变量旁标明。

# ============================================================================
# 第一层: 必需配置
# ============================================================================

# 主对话后端: openai / lmstudio
# MAIN_MODEL_TYPE=openai

# 主对话模型名称。必须是对应后端实际可用的模型 ID。
# MAIN_MODEL_NAME=deepseek-v4-flash

# 使用 openai 后端时必填；纯 LMStudio 模式可留空。
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容 API 根地址，不包含 /chat/completions。
# OPENAI_API_BASE=https://api.deepseek.com/v1

# ============================================================================
# 第二层: 服务、存储与安全
# ============================================================================

# HTTP 服务
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000
# SERVER_BASE_URL=
# LOCAL_CALLBACK_PORT=5001

# 数据与日志
# DATABASE_PATH=DSN_usrdata.db
# WORKSPACE_DIR=.dsn/workspace
# LOG_DIR=logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=30
# LOG_BUFFER_SIZE=200

# 生产环境必须替换为足够长的随机字符串。
# JWT_SECRET=dsn-exp-auto-secret

# ============================================================================
# 第三层: 模型基础设施
# ============================================================================

# LMStudio
# LMSTUDIO_ENABLED=true
# LMSTUDIO_BASE_URL=http://localhost:4501
# LMSTUDIO_TEMPERATURE=0.7
# LMSTUDIO_MAX_TOKENS=4096
# LMSTUDIO_TIMEOUT=300

# 独立推理模型
# REASONER_ENABLED=true
# REASONER_MODEL=deepseek-v4-pro
# REASONER_TIMEOUT=1200

# 本地模型调度
# MAX_CONCURRENT_LM_MODELS=1
# MODEL_LOAD_TIMEOUT=180
# MODEL_REQUEST_TIMEOUT=300

# 费用估算，单位 USD / 1M tokens。仅用于展示，不影响请求。
# TOKEN_PRICE_FLASH_INPUT=0.14
# TOKEN_PRICE_FLASH_OUTPUT=0.28
# TOKEN_PRICE_PRO_INPUT=0.435
# TOKEN_PRICE_PRO_OUTPUT=0.87

# ============================================================================
# 第四层: 记忆、人格、世界和工具
# ============================================================================

# 记忆与摘要
# MEMORY_ENABLED=true
# MEMORY_SUMMARY_BACKEND=openai
# MEMORY_MODEL=deepseek-v4-flash
# MEMORY_SUMMARY_LENGTH=100
# MEMORY_CONTEXT_WINDOW_SIZE=80
# MEMORY_REPLACE_THRESHOLD_RATIO=0.7
# MEMORY_ASYNC_ENABLED=true
# MEMORY_SEARCH_THRESHOLD=0.5
# MEMORY_DETAIL_CHARS_PER_ROUND=4000
# MEMORY_TOTAL_DETAIL_CHARS=16000
# MEMORY_QUERY_LIMIT=50

# 摘要 API 容错与上下文
# SUMMARY_TIMEOUT=60
# SUMMARY_RETRY_COUNT=3
# SUMMARY_RETRY_BACKOFF_SECONDS=1.0
# SUMMARY_CONTEXT_SIZE=10
# SUMMARY_TEMPERATURE=0.1

# 向量嵌入。启用后需要 LMStudio 中存在该 embedding 模型。
# MEMORY_EMBEDDING_ENABLED=false
# MEMORY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@f16
# MEMORY_EMBEDDING_DIMS=768
# MEMORY_EMBEDDING_WEIGHT=0.6

# ── 话题系统 (与记忆深度绑定) ──
# 对话按 30min 静默 + 语义无关划入话题; 当前/激活话题注入原文, 关闭话题注入聚合摘要。
# TOPIC_ENABLED=true
# TOPIC_IDLE_SECONDS=1800            # 30min 不聊 → 关话题 / 划新话题
# TOPIC_ACTIVATION_THRESHOLD=0.55    # 被动激活(词嵌入命中旧话题)
# TOPIC_CONTINUE_THRESHOLD=0.65      # 续当前话题免 judge 的相似度下限
# TOPIC_REOPEN_THRESHOLD=0.50        # 重开旧话题的相似度下限
# TOPIC_TAIL_ROUNDS=10               # 原始尾部窗口(轮)
# TOPIC_MAX_OPEN_TOPICS=3           # 同时打开话题上限
# TOPIC_MAX_VERBATIM_CHARS=6000      # 话题原文注入总预算(字符)
# TOPIC_SUMMARY_CHARS=2000           # 闭锁话题摘要总预算(字符)
# TOPIC_MEMO_CHARS=1200              # 备忘总预算(字符)
# TOPIC_JUDGE_ENABLED=true           # 归属歧义时用 LLM 确认
# TOPIC_JUDGE_ALWAYS=false           # 强制每轮 judge(调试)
# TOPIC_CANDIDATE_K=3                # judge 候选旧话题数

# 人格系统 V3
# PERSONALITY_V3_ENABLED=true
# PERSONALITY_V3_OVERRIDE_V2=true
# PERSONALITY_MODEL_NAME=google/gemma-3-4b
# PERSONALITY_MODEL_URL=http://localhost:4501
# DISTILLATION_MODEL=openai
# PERSONALITY_V3_DEFAULT_CARD=

# 世界与叙事
# WORLD_ENABLED=true
# WORLD_PRESET=default
# WORLD_UPDATE_INTERVAL=60
# NARRATIVE_ENABLED=true
# NARRATIVE_MODEL_TYPE=lmstudio
# NARRATIVE_MODEL=google/gemma-3-4b
# NARRATIVE_TEMPERATURE=0.9
# NARRATIVE_MAX_TOKENS=150
# NARRATIVE_KEEP_HISTORY=false
# NARRATIVE_PRE_ENABLED=true

# 工具调用
# TOOL_CALL_MODE=native
# TOOL_CALL_MODEL=deepseek-v4-pro
# TOOLBOX_ENABLED=true
# MODEL_MAX_HISTORY=12             # 主模型对话历史裁剪上限（非 system 消息条数，0=不裁剪）
# FILE_READ_MAX_SIZE_MB=1

# ============================================================================
# 第五层: 语音系统
# ============================================================================

# ASR
# ASR_ENABLED=false
# ASR_DEVICE=cuda
# ASR_GPU_ID=
# ASR_BATCH_SIZE_SECONDS=60
# ASR_CONVERT_TIMEOUT=15
# DEBUG_ASR=false

# ASR 对话/环境噪声过滤器
# ASR_FILTER_ENABLED=false
# FILTER_MODEL=llama-3.2-1b-instruct

# TTS 服务
# TTS_ENABLED=true
# TTS_BASE_URL=http://127.0.0.1:9880
# TTS_PROBE_TIMEOUT=3.0
# TTS_PROBE_ATTEMPTS=4
# TTS_PROBE_RETRIES=4  # 旧名称，仅为兼容；优先使用 TTS_PROBE_ATTEMPTS
# TTS_PROBE_BACKOFF_BASE=2.0
# TTS_PROBE_BACKOFF_MAX=8.0
# TTS_FAST_FIRST_LINE=true

# TTS 文本预处理模型
# TTS_PROCESS_ENABLED=true
# TTS_PROCESS_MODEL=google/gemma-3-4b
# TTS_PROCESS_MAX_TOKENS=1024
# TTS_PROCESS_TEMPERATURE=0.2
# TTS_PROCESS_TIMEOUT=30

# ============================================================================
# 第六层: 视觉、OCR 与文档
# ============================================================================

# 通用视觉模型
# VISION_ENABLED=true
# VISION_API_KEY=
# VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL_NAME=glm-4.6v
# VISION_PROMPT=请详细描述这张图片的内容
# VISION_OVERRIDE=false
# VISION_WARMUP=true                 # 启动后台预热 VLM，摊薄首次 look_around 冷启动
# VISION_LOOK_AROUND_DEDUP=10        # look_around 短时去重窗口（秒）：同 focus+camera 窗口内复用上次结果

# OCR 与文档解析
# OCR_MODEL=deepseek-ocr
# OCR_BASE_URL=http://localhost:4502
# OCR_UNLOAD_AFTER_USE=true
# TWO_MD_API=http://localhost:8000

# 摄像头与主动视觉
# CAMERA_ENABLED=true
# CAMERA_DEVICE_ID=0
# 多摄像头逻辑名映射 (格式: 逻辑名=设备索引, 逗号分隔)。客户端按此命名，look_around 可传逻辑名
# DSN_CAMERA_MAP=front=0,usb=2
# ── 远程摄像头 (webcam infra) ──
# 通过后端控制台 /webcam 命令或 REST API (POST /api/vision/webcams) 添加远程摄像头
# (RTSP / HTTP MJPEG / 快照 URL)。添加后可像本地物理摄像头一样用 look_around 调用。
# WEBCAM_CONFIG_PATH=.dsn/webcams.json     # 远程摄像头注册表持久化路径
# WEBCAM_OPEN_TIMEOUT=5                    # 打开流超时（秒）
# WEBCAM_FRAME_TIMEOUT=8                   # 单帧抓取超时（秒）
# WEBCAM_MAX_FRAMES=4                      # 多台并发抓帧线程上限
# STREAM_LOCAL_INTERVAL=2.0                # 本地摄像头实时监控流的推送间隔（秒）：
#                                          # webUI 监控页有本地流订阅时，minimal.py 按此周期抓帧推送
# ACTIVE_VISION_ENABLED=false
# ACTIVE_VISION_INTERVAL=300
# ACTIVE_VISION_CAMERA=          # 周期观察用哪台摄像头(逻辑名), 空=主摄像头
# ACTIVE_VISION_PROACTIVE_COOLDOWN=600
# ACTIVE_VISION_PERIODIC_NOTIFY_MIN=30

# ── 闲置时感知 (idle-time sensing) ──
# 客户端在未按 Enter 录音时持续监听麦克风，感知到响动就捕捉并上报后端 ASR 存档。
# 聆听能力由 tracking 子系统（用户跟踪系统 infra）提供，见 tracking 配置。
# SENSING_ENABLED=false
# SENSING_COOLDOWN=60              # 两次上报的最小间隔（秒）
# SENSING_MAX_RECORD_SECS=6.0      # 单条感知片段的最大时长（秒）
# SENSING_AI_ACCESS_ENABLED=false  # （兼容旧开关）允许 AI 通过工具查询闲置时感知记录

# ── 用户跟踪系统 (tracking, infra) ──
# 通过不断观察以多模态方式（拍照/录像/录音/文件/文本）记录用户行动，
# 建模用户作息/节奏/项目进度的个人行为日记本。闲时感知（仅音频）依赖它。
# 数据存于独立加密数据库（tracking.db，payload/meta 经 AES-256-GCM 加密，按用户派生密钥）。
# TRACKING_ENABLED=false                       # 主开关（聆听能力）；缺省时跟随 SENSING_ENABLED
# TRACKING_AI_ACCESS_ENABLED=false             # 允许 AI 通过工具完全访问（查询/添加/建模）观察日志
# TRACKING_MEDIA_ROOT=.dsn/tracking_media      # 拍照/录像/录音/文件媒体保存根目录
# TRACKING_DB_PATH=                           # 独立加密库路径；为空放 <MEDIA_ROOT>/../tracking/tracking.db
# TRACKING_SAVE_AUDIO=true                     # 闲时感知音频是否同时保存真实 WAV（完整日记）

# ============================================================================
# 第七层: 认证、任务、维护与缓存
# ============================================================================

# 分层认证
# AUTH_SESSION_DAYS=30
# AUTH_PAIRING_DIGITS=8
# AUTH_PAIRING_TIMEOUT=300
# AUTH_WEBAUTHN_RP_NAME=DSN-exp
# AUTH_TOTP_ISSUER=DSN-exp
# LITTLESKIN_CLIENT_ID=
# LITTLESKIN_CLIENT_SECRET=

# 任务与 Agent
# TASK_MANAGER_ENABLED=true
# TASK_MAX_WORKERS=5
# TASK_COMPLEXITY_THRESHOLD=0.4
# REMINDER_CHECK_INTERVAL=60
# REMINDER_LIST_LIMIT=50
# TASK_NOTIFICATION_ENABLED=true
# ACTION_TIMEOUT=300
# AGENT_MAX_STEPS=10
# AGENT_TOKEN_BUDGET=1000000
# AGENT_TIMEOUT_SECONDS=120

# 维护与 Hibernate
# MAINTENANCE_ENABLED=true
# HIBERNATE_MAX_QUEUE=100
# HIBERNATE_PERSONALITY_COOLDOWN=30   # 挂起的人格分析同用户最小间隔（秒），降低本地 GPU 争抢
# HIBERNATE_MEMORY_COOLDOWN=60        # 挂起的记忆摘要同用户最小间隔（秒）
# MAINTENANCE_SCHEDULE_STRATEGY=predictive
# MAINTENANCE_FIXED_HOUR=4
# MAINTENANCE_IDLE_TIMEOUT_MINUTES=60
# MAINTENANCE_SCHEDULE_CHECK_INTERVAL=60
# MAINTENANCE_PREDICTIVE_MIN_FREE_HOURS=3
# MAINTENANCE_PREDICTIVE_MAX_HOUR=8
# MAINTENANCE_PREDICTIVE_IDLE_TRIGGER_MINUTES=60
# MAINTENANCE_PREDICTIVE_MIN_DATA_SAMPLES=50
# MAINTENANCE_RETRY_ON_FAILURE=true
# MAINTENANCE_RETRY_DELAY_MINUTES=30
# MAINTENANCE_ESTIMATE_PER_TASK_SECONDS=300
# MAINTENANCE_TASK_TIMEOUT_SECONDS=600

# 驻守模型
# STEWARD_ENABLED=true
# STEWARD_MODEL_TYPE=openai
# STEWARD_MODEL_NAME=google/gemma-3-4b
# STEWARD_TIMEOUT=300
# STEWARD_TEMPERATURE=0.5
# STEWARD_MAX_TOKENS=2048
# STEWARD_HISTORY_LIMIT=40

# 语义缓存
# SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_DIR=.dsn/semantic_cache
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85
# SEMANTIC_CACHE_MAX_ENTRIES=5000

# 其他高级功能
# PERFORMANCE_MODE=realtime
# NOTEBOOK_ENABLED=true
# NOTEBOOK_FREQUENCY=10

# ============================================================================
# 可选客户端、管理端、技能与调试
# ============================================================================

# Web 管理端
# WEB_ADMIN_ENABLED=false
# WEB_ADMIN_HOST=127.0.0.1
# WEB_ADMIN_PORT=8008
# WEB_ADMIN_PASSWORD=

# Agent CLI。DSN_AGENT_API_KEY 为已创建 Agent 的密钥。
# DSN_AGENT_API_KEY=
# DSN_BASE_URL=http://127.0.0.1:5000
# DSN_AGENT_TIMEOUT=300
# DSN_MESSAGE=

# ── 双模协同 (Instant + Main) ──
# 启用后，用户消息先到 Instant 模型(本地LMStudio)即时回复；
# 需要工具时 Instant 通过 <summon> 触发主模型 agent loop，
# 每轮工具调用由 Instant 生成进度摘要并 SSE+TTS 推送给用户。
# DUAL_ENABLED=true
# Instant 模型名称 (LMStudio 模型 ID)
# INSTANT_MODEL=google/gemma-3-4b
# Instant 模型地址，为空则复用 LMSTUDIO_BASE_URL
# INSTANT_MODEL_URL=http://localhost:4501
# INSTANT_TEMPERATURE=0.6
# INSTANT_MAX_TOKENS=512
# INSTANT_TIMEOUT=15
# 主模型线程池大小 (并发 agent loop 数上限)
# DUAL_MAIN_WORKERS=3
# Instant 持久上下文：保留的最近消息条数 & 触发压缩的阈值
# INSTANT_CONTEXT_MAX_MESSAGES=30
# INSTANT_CONTEXT_COMPRESS_THRESHOLD=40

# 技能外部服务
# WEB_SEARCH_API_BASE=
# WEB_SEARCH_MODEL=
# NCM_MUSIC_U=
# PYNCM_DEBUG=false

# 调试：以另一用户身份手动输入模型回复。
# DEBUG_PLAY_AS_MODEL=false
# DEBUG_PLAY_AS_MODEL_PORT=5050
