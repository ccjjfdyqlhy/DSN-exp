# DSN-exp 环境变量配置
# 复制此文件为 .env 并填入你的密钥

# ==================== 必需配置 ====================
# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-key-here

# LittleSkin OAuth2 配置
LITTLESKIN_CLIENT_ID=your_client_id
LITTLESKIN_CLIENT_SECRET=your_client_secret

# JWT 签名密钥（生成随机字符串，越长越安全）
JWT_SECRET=generate-a-random-secret-string-here

# ==================== 可选配置 ====================
# 主模型类型: deepseek 或 lmstudio
MAIN_MODEL_TYPE=deepseek

# LMStudio 本地地址（使用 lmstudio 时需要）
# LMSTUDIO_BASE_URL=http://localhost:4501

# TTS 服务地址
# TTS_BASE_URL=http://127.0.0.1:9880

# 推理模型配置
# REASONER_ENABLED=true
# REASONER_MODEL=deepseek-reasoner

# 服务地址
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000

# 记忆与摘要
# MEMORY_ENABLED=true
# MEMORY_MODEL=deepseek-chat

# ASR（默认关闭，需要本地 GPU）
# ASR_ENABLED=false

# 任务管理
# TASK_MANAGER_ENABLED=true
