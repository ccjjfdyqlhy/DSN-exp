# DSN-exp 环境变量配置
# 复制此文件为 .env 并填入你的密钥
#
# 格式: 所有带默认值的配置项都已注释掉。
#       仅 DEEPSEEK_API_KEY 是必需的（取消注释并填入密钥即可）。
#       其余配置项可保持默认值，需要时取消注释修改。

# ==================== 必需配置 ====================
# API Key (从 https://platform.deepseek.com 或对应服务商获取, 必填)
OPENAI_API_KEY=sk-your-key-here

# ==================== 验证系统 ====================
# LittleSkin OAuth2 (可选)
# LITTLESKIN_CLIENT_ID=your_client_id
# LITTLESKIN_CLIENT_SECRET=your_client_secret

# JWT 签名密钥 (随机字符串)
# JWT_SECRET=dsn-exp-auto-secret

# ==================== 分层认证系统 ====================
# AUTH_SESSION_DAYS=30
# AUTH_PAIRING_DIGITS=8
# AUTH_PAIRING_TIMEOUT=300
# AUTH_WEBAUTHN_RP_NAME=DSN-exp
# AUTH_TOTP_ISSUER=DSN-exp

# ==================== OpenAI 兼容 API ====================
# 若使用非 DeepSeek 的 OpenAI 兼容 API，请取消注释并修改地址
# OPENAI_API_BASE=https://api.deepseek.com/v1
# REASONER_ENABLED=true
# REASONER_MODEL=deepseek-v4-pro
# REASONER_TIMEOUT=1200

# ==================== 本地服务 API ====================
# LMSTUDIO_BASE_URL=http://localhost:4501
# TTS_BASE_URL=http://127.0.0.1:9880

# ==================== 主模型配置 ====================
# MAIN_MODEL_TYPE=openai
# MAIN_MODEL_NAME=deepseek-v4-flash
# LMSTUDIO_TEMPERATURE=0.7
# LMSTUDIO_MAX_TOKENS=4096
# LMSTUDIO_TIMEOUT=300

# ==================== 存储配置 ====================
# DATABASE_PATH=DSN_usrdata.db
# LOG_DIR=logs

# ==================== 服务配置 ====================
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000
# SERVER_BASE_URL=
# LOCAL_CALLBACK_PORT=5001

# ==================== 记忆与摘要 ====================
# MEMORY_ENABLED=true
# MEMORY_SUMMARY_BACKEND=openai
# MEMORY_MODEL=deepseek-v4-flash
# MEMORY_SUMMARY_LENGTH=100
# MEMORY_CONTEXT_WINDOW_SIZE=80
# MEMORY_REPLACE_THRESHOLD_RATIO=0.7
# MEMORY_ASYNC_ENABLED=true

# ==================== 向量嵌入检索 ====================
# 启用后 MemorySystem 会对对话摘要生成 embedding，支持语义搜索
# 同时也用于 PromptCache 的 <help> 标签检索
# 需要 LMStudio 上运行 text-embedding 模型
# MEMORY_EMBEDDING_ENABLED=true
# MEMORY_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@f16
# MEMORY_EMBEDDING_DIMS=768
# MEMORY_EMBEDDING_WEIGHT=0.6

# ==================== 用户观察日记 ====================
# NOTEBOOK_ENABLED=true
# NOTEBOOK_FREQUENCY=10

# ==================== TTS 文本预处理 ====================
# TTS_PROCESS_ENABLED=true
# TTS_PROCESS_MODEL=google/gemma-3-4b
# TTS_PROCESS_MAX_TOKENS=1024
# TTS_PROCESS_TEMPERATURE=0.2
# TTS_PROCESS_TIMEOUT=30

# ==================== ASR 配置 ====================
# ASR_ENABLED=false
# ASR_DEVICE=cuda
# ASR_GPU_ID=          # 指定 GPU 编号（如 "0" "1"），留空则用 ASR_DEVICE
# DEBUG_ASR=false

# ==================== ASR 过滤 ====================
# ASR_FILTER_ENABLED=false
# FILTER_MODEL=llama-3.2-1b-instruct

# ==================== 任务管理 ====================
# TASK_MANAGER_ENABLED=true
# TASK_MAX_WORKERS=5
# TASK_COMPLEXITY_THRESHOLD=0.4
# REMINDER_CHECK_INTERVAL=60
# TASK_NOTIFICATION_ENABLED=true
# ACTION_TIMEOUT=300

# ==================== Agent 循环 ====================
# AGENT_MAX_STEPS=10

# ==================== 工具调用模式 ====================
# 工具注入策略: "native" — OpenAI 原生 function calling (默认)
#                     "xml" — 文本注入 XML <tool> 标签语法
#                     "auto" — 自动根据模型类型选择
# TOOL_CALL_MODE=native
# 工具调用判定模型（仅在 TOOL_CALL_MODE=auto 时生效）
# TOOL_CALL_MODEL=deepseek-v4-pro

# ==================== 动态工具箱 ====================
# 启用后，AI 每轮只收到一个 `toolbox` 工具列出所有 skill，
# 模型先思考需要哪些工具，调用 toolbox 激活后才注入完整 schema。
# 禁用则恢复旧的全量发送模式。
# TOOLBOX_ENABLED=true

# ==================== 叙事世界模型 ====================
# WORLD_ENABLED=true
# WORLD_PRESET=default
# WORLD_UPDATE_INTERVAL=60

# NARRATIVE_ENABLED=true
# NARRATIVE_MODEL_TYPE=lmstudio
# NARRATIVE_MODEL=google/gemma-3-4b
# NARRATIVE_TEMPERATURE=0.9
# NARRATIVE_MAX_TOKENS=150
# NARRATIVE_KEEP_HISTORY=false
# NARRATIVE_PRE_ENABLED=true

# ==================== 驻守模型 ====================
# STEWARD_ENABLED=true
# STEWARD_MODEL_TYPE=openai
# STEWARD_MODEL_NAME=google/gemma-3-4b
# STEWARD_TIMEOUT=300

# ==================== 模型共存管理 ====================
# 限制同时加载的语言大模型数量（词向量嵌入模型不计入）
# MAX_CONCURRENT_LM_MODELS=1
# 模型加载超时（秒）
# MODEL_LOAD_TIMEOUT=180
# 任务队列最长等待时间（秒）
# MODEL_REQUEST_TIMEOUT=300
# 流式语音首句跳过 LLM 文本预处理，先让用户听到声音
# TTS_FAST_FIRST_LINE=true

# ==================== 工作区系统 ====================
# WORKSPACE_DIR=.dsn/workspace

# ==================== 视觉多模态 ====================
# VISION_ENABLED=true
# VISION_PROMPT=请详细描述这张图片的内容

# ==================== 视觉模型 API（通用视觉，如 GLM-4.6V / GPT-4V）====================
# VISION_API_KEY=your-api-key
# VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL_NAME=glm-4.6v
# 启用后 VisionModel 接管所有 OCR + 2md 布局分析，直接生成 .hmd（需先配置 VISION_* 键）
# VISION_OVERRIDE=false

# ==================== 摄像头感知 ====================
# CAMERA_ENABLED=true
# CAMERA_DEVICE_ID=0

# ==================== 主动视觉感知 ====================
# 总开关：启用后周期性捕获摄像头画面，检测场景变化并主动通知
# ACTIVE_VISION_ENABLED=false
# 主动观测间隔（秒）
# ACTIVE_VISION_INTERVAL=300
# 主动通知冷却时间（秒），避免短时间内重复通知
# ACTIVE_VISION_PROACTIVE_COOLDOWN=600
# 周期性通知最小间隔（分钟）
# ACTIVE_VISION_PERIODIC_NOTIFY_MIN=30

# ==================== OCR 文档处理 ====================
# OCR_MODEL=deepseek-ocr
# OCR_BASE_URL=http://localhost:4502
# OCR_UNLOAD_AFTER_USE=true

# ==================== 2md 文档解析 API ====================
# TWO_MD_API=http://localhost:8000

# ==================== 网易云音乐 ====================
# 从 https://music.163.com 登录后，F12 → Application → Cookies → music.163.com → MUSIC_U
# NCM_MUSIC_U=your-music-u-cookie

# ==================== 人格系统 v3 ====================
# PERSONALITY_V3_ENABLED=true
# PERSONALITY_V3_OVERRIDE_V2=true
# PERSONALITY_MODEL_NAME=google/gemma-3-4b
# PERSONALITY_MODEL_URL=http://localhost:4501
# DISTILLATION_MODEL=openai
# PERSONALITY_V3_DEFAULT_CARD=

# ==================== 语义缓存系统 ====================
# 启用后对 AI 回复进行逐级缓存（L1 固定短语 / L2 语义 / L3 向量检索）
# 需启用 MEMORY_EMBEDDING_ENABLED 才能使用 L3 向量检索
# SEMANTIC_CACHE_ENABLED=false
# 缓存存储目录
# SEMANTIC_CACHE_DIR=.dsn/semantic_cache
# 语义命中阈值（越高要求越精确）
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85
# 最大缓存条目数
# SEMANTIC_CACHE_MAX_ENTRIES=5000

# ==================== 性能模式 ====================
# "realtime" — 完整实时流程（World旁白/情绪分析/记忆摘要同步执行）
# "fastcache" — 快速缓存模式，旁白/情绪/记忆挂起到 Hibernate 空闲队列延迟执行
# PERFORMANCE_MODE=realtime

# ==================== 服务器维护 & Hibernate 延迟队列 ====================
# 主开关：关闭后不启动维护时钟/状态机/API（默认启用）
# MAINTENANCE_ENABLED=true
# Hibernate 队列最大长度（超出丢弃旧任务）
# HIBERNATE_MAX_QUEUE=100
# 调度策略: fixed / predictive / manual
# MAINTENANCE_SCHEDULE_STRATEGY=predictive
# fixed 策略时固定维护时间（24h 制）
# MAINTENANCE_FIXED_HOUR=4
# 持续无请求多少分钟后进入待机
# MAINTENANCE_IDLE_TIMEOUT_MINUTES=60
# 维护调度检查间隔（秒）
# MAINTENANCE_SCHEDULE_CHECK_INTERVAL=60

# ==================== 调试模式 ====================
# 启用后允许在 5050 端口以另一用户身份手动输入 AI 应回复的内容
# 用于测试 AI 对不同回复风格的反应（情绪/亲和力变化）
# DEBUG_PLAY_AS_MODEL=false
# 调试模式监听端口
# DEBUG_PLAY_AS_MODEL_PORT=5050
