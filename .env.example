# DSN-exp 环境变量配置
# 复制此文件为 .env 并填入你的密钥

# ==================== 必需配置 ====================
# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-key-here

# LittleSkin OAuth2 配置
LITTLESKIN_CLIENT_ID=your_client_id
LITTLESKIN_CLIENT_SECRET=your_client_secret

# JWT 签名密钥（生成随机字符串，越长越安全）
JWT_SECRET=generate-a-random-secret-string-here

# 服务器局域网部署地址（替换为你的服务器局域网 IP 地址）
# SERVER_BASE_URL=http://192.168.1.2:5000

# ==================== 可选配置 ====================
# 主模型类型: deepseek 或 lmstudio
MAIN_MODEL_TYPE=deepseek

# LMStudio 本地地址（使用 lmstudio 时需要）
# LMSTUDIO_BASE_URL=http://localhost:4501

# TTS 服务地址
# TTS_BASE_URL=http://127.0.0.1:9880

# 推理模型配置
# REASONER_ENABLED=true
# REASONER_MODEL=deepseek-reasoner

# 服务地址
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000

# 记忆与摘要
# MEMORY_ENABLED=true
# MEMORY_SUMMARY_BACKEND=deepseek   # deepseek | lmstudio
# MEMORY_MODEL=deepseek-v4-flash

# ==================== 驻守模型 ====================
# 驻守模型类型: deepseek 或 lmstudio
# STEWARD_MODEL_TYPE=lmstudio
# STEWARD_MODEL_NAME=google/gemma-3-4b
# STEWARD_TIMEOUT=300

# ==================== 叙事旁白模型 ====================
# 旁白模型类型: deepseek 或 lmstudio
# NARRATIVE_MODEL_TYPE=lmstudio
# NARRATIVE_MODEL=google/gemma-3-4b
# NARRATIVE_TEMPERATURE=0.9
# NARRATIVE_MAX_TOKENS=150

# ==================== TTS 文本预处理 ====================
# 是否启用 TTS 文本友好化处理（调用本地 LLM 优化朗读文本）
# TTS_PROCESS_ENABLED=true

# TTS 预处理使用的本地模型（默认使用与记忆摘要相同的模型）
# TTS_PROCESS_MODEL=google/gemma-3-4b

# TTS 预处理最大 token 数
# TTS_PROCESS_MAX_TOKENS=1024

# TTS 预处理温度（低温度保证输出稳定）
# TTS_PROCESS_TEMPERATURE=0.2

# TTS 预处理请求超时（秒）
# TTS_PROCESS_TIMEOUT=30

# ASR（默认关闭，需要本地 GPU）
# ASR_ENABLED=false

# 任务管理
# TASK_MANAGER_ENABLED=true
